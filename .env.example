# File Name: .env.example
# Purpose: Safe template listing environment variable names/placeholders without real secrets.
# Creation Date: 2026-09-13
# Author: K.Kashiwagi

# -----------------------------------------------------------------------
# Environment variable template for Healthcare AI Forward Deployment Lab
#
# This file contains VARIABLE NAMES ONLY.
# Do NOT put real secrets, endpoints, server names, or IDs in this file.
# Copy this file to ".env" locally and fill in real values there.
# ".env" is excluded from Git via .gitignore.
# -----------------------------------------------------------------------

# --- Azure OpenAI / Azure AI Foundry ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- Database (Microsoft SQL Server, local) ---
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Application configuration ---
APP_ENV=
LOG_LEVEL=
