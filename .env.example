# File Name: .env.example
# Purpose: Safe template listing environment variable names/placeholders without real secrets.
# Creation Date: 2026-09-13
# Author: K.Kashiwagi

# -----------------------------------------------------------------------
# Environment variable template for Healthcare AI Forward Deployment Lab
#
# This file contains VARIABLE NAMES ONLY.
# Do NOT put real secrets, endpoints, server names, or IDs in this file.
# Copy this file to ".env" locally and fill in real values there.
# ".env" is excluded from Git via .gitignore.
# -----------------------------------------------------------------------

# --- Azure OpenAI / Azure AI Foundry ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION is retained for compatibility/reference only.
# It is NOT read or used by the current Azure OpenAI v1 client path
# (src/config/settings.py, src/ai/client_factory.py), which talks to
# "<endpoint>/openai/v1/" without an api_version parameter. Do not
# remove this variable name yet; a future task may still need it if an
# alternate API path is added.
AZURE_OPENAI_API_VERSION=

# --- Database (Microsoft SQL Server, local) ---
# DB_SERVER, DB_NAME, DB_USER, and DB_PASSWORD below are placeholder
# names from the original project scaffold. The database settings code
# added in Task 18A (src/config/database.py) does not read them -- it
# reads a single, already-assembled ODBC connection string instead.
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=

# SQL_SERVER_CONNECTION_STRING is the variable actually read by
# src/config/database.py (Task 18A). It should hold one complete ODBC
# connection string for your local Microsoft SQL Server instance.
# The real value belongs only in your local .env file or a proper
# secret-management system -- never commit the real value here or
# anywhere else. Task 18A does not connect to SQL Server; it only
# defines how this value would be loaded and validated. Task 18B is
# the first task that validates it against a real local SQL Server.
SQL_SERVER_CONNECTION_STRING=

# --- Application configuration ---
APP_ENV=
LOG_LEVEL=
